# Ignore the output video from Git but not videos you import into src/.
out

# The repo root ignores every lib/ (Python packaging); this one is source.
!src/lib/

# What if films: AI media and rendered sound stay out of git (public/whatif/<film>/jobs.json keeps their URLs;
# python3 lab/whatif/fetch.py <film> downloads them again and rebuilds the sound)
public/whatif/*/c*.mp4
public/whatif/*/keys/
public/whatif/*/sound*.wav
public/whatif/*/sound*.mp3
