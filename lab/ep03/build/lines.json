   "end": 84.21,
   "card": null,
   "mark": 2026,
   "id": "now",
   "slot": null,
   "cut": false,
   "ladder": false,
   "drop": false,
   "quiet": false
  },
  {
   "i": 13,
   "floor": 2,
   "text": "Every one of them with a pitch deck that says revolutionary on slide one.",
   "start": 84.706,
   "end": 89.603,
   "card": null,
   "mark": null,
   "id": null,
   "slot": "e4",
   "cut": false,
   "ladder": false,
   "drop": false,
   "quiet": false
  },
  {
   "i": 14,
   "floor": 2,
   "text": "Meanwhile, the takeaway round the corner still hands up to thirty percent of every order to an app.",
