   "card": null,
   "mark": null,
   "id": "before",
   "slot": null,
   "cut": true,
   "ladder": false,
   "drop": false,
   "quiet": false
  },
  {
   "i": 18,
   "floor": 3,
   "text": "1846. Britain goes railway mad. Parliament approves hundreds of new railway companies.",
