   "mark": null,
   "id": "36k",
   "slot": null,
   "cut": false,
   "ladder": false,
   "drop": false,
   "quiet": false
  },
  {
   "i": 4,
   "floor": 0,
   "text": "In 1848 money. That's not rich. That's buy-the-street rich.",
   "start": 28.941,
   "end": 33.567,
   "card": null,
   "mark": null,
   "id": null,
   "slot": "e2",
   "cut": false,
   "ladder": false,
   "drop": false,
   "quiet": false
  },
  {
   "i": 5,
   "floor": 0,
   "text": "He never dug for gold. Not once. Not one fucking scoop.",
   "start": 34.588,
   "end": 38.596,
   "card": [
    "1ST MILLIONAIRE",
    "CALIFORNIA \u00b7 WITHOUT MINING"
