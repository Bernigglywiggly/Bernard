   "end": 107.369,
   "card": null,
   "mark": null,
   "id": null,
   "slot": "e5",
   "cut": false,
   "ladder": false,
   "drop": false,
   "quiet": false
  },
  {
   "i": 17,
   "floor": 3,
   "text": "And none of this is new. It's the oldest pattern in money.",
