 "lines": [
  {
   "i": 0,
   "floor": 0,
   "text": "1848. San Francisco. A shopkeeper called Sam Brannan walks down the street holding up a bottle of gold, like he's just won the bloody Champions League.",
   "start": 2.824,
   "end": 13.576,
   "card": [
    "1848",
    "SAN FRANCISCO \u00b7 A BOTTLE OF GOLD"
   ],
   "mark": 1848,
   "id": "bottle",
   "slot": null,
   "cut": false,
   "ladder": false,
   "drop": false,
   "quiet": false
  },
  {
   "i": 1,
   "floor": 0,
   "text": "The whole city loses its mind. Half the town downs tools and legs it for the river.",
   "start": 14.118,
   "end": 19.682,
   "card": null,
   "mark": null,
   "id": "mind",
   "slot": null,
   "cut": false,
   "ladder": false,
   "drop": false,
   "quiet": false
  },
  {
   "i": 2,
   "floor": 0,
   "text": "And Sam? Sam had already bought up the pans. And the shovels.",
   "start": 20.471,
   "end": 24.228,
   "card": null,
   "mark": null,
   "id": "shop",
   "slot": null,
   "cut": false,
   "ladder": false,
   "drop": false,
   "quiet": false
  },
  {
   "i": 3,
   "floor": 0,
   "text": "Nine weeks later, he'd made thirty-six thousand dollars.",
   "start": 24.706,
   "end": 28.231,
   "card": [
    "$36,000",
    "IN NINE WEEKS \u00b7 SELLING SUPPLIES"
