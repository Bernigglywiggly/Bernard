   "cut": false,
   "ladder": false,
   "drop": false,
   "quiet": false
  },
  {
   "i": 15,
   "floor": 2,
   "text": "It doesn't need a startup. It needs someone who knows what the tools can do, and has the bollocks to walk in the door.",
   "start": 96.706,
   "end": 103.442,
   "card": null,
   "mark": null,
   "id": "door",
   "slot": null,
   "cut": false,
   "ladder": false,
   "drop": false,
   "quiet": false
  },
  {
   "i": 16,
   "floor": 2,
   "text": "That's the shovel. It's not glamorous. Neither was a shovel.",
